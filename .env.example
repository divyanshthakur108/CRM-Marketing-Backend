# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/real_estate_ai_crm

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175


# Authentication & Security
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform Admin Seed Credentials
ADMIN_EMAIL=admin@realcrm.in
ADMIN_PASSWORD=AdminPassword123!

# Email Service (Nodemailer SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=RealCRM Platform <no-reply@realcrm.in>

# Media & Storage Limits
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200
MEDIA_MAX_PDF_MB=20
MEDIA_MAX_FILES_PER_PROJECT=100
MEDIA_UPLOAD_RATE_LIMIT=120

# Creative Engine & Video Rendering (ffmpeg & AI provider)
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
AI_DAILY_COST_CAP_USD=25.00
AI_MAX_VIDEO_SECONDS_PER_REEL=25
REEL_MUSIC_PATH=


